---
import Layout from "@/layouts/Layout.astro";

interface Post {
    frontmatter: {
        title: string;
        description: string;
        pubDate: string;
        slug?: string;
    };
    file: string;
}

const posts = Object.values(
    import.meta.glob("../../content/blog/*.md", { eager: true }),
) as any[];
---

<Layout
    title="Blog — B. Digital Portfolio"
    description="Reflexiones sobre desarrollo web, diseño y cultura paraguaya."
>
    <section class="py-32 px-6">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-16">
                Blog<span class="text-accent">.</span>
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                {
                    posts && posts.length > 0 ? (
                        posts.map((post) => (
                            <div class="project-card group">
                                <div class="aspect-[16/10] overflow-hidden bg-neutral-900 rounded-2xl mb-8 relative">
                                    <div class="absolute inset-0 bg-neutral-900 flex items-center justify-center font-black text-[12vw] text-neutral-800 select-none group-hover:text-accent/10 transition-colors">
                                        {post.frontmatter.heroImage ? (
                                            <img
                                                src={post.frontmatter.heroImage}
                                                alt={post.frontmatter.title}
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            />
                                        ) : (
                                            <span class="text-4xl">📝</span>
                                        )}
                                    </div>
                                </div>
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h3 class="text-3xl font-bold tracking-tighter mb-2">
                                            <a
                                                href={`/blog/${post.frontmatter.slug || post.file.split("/").pop().replace(".md", "")}`}
                                                class="hover:text-accent transition-colors"
                                            >
                                                {post.frontmatter.title}
                                            </a>
                                        </h3>
                                        <p class="text-neutral-500 font-mono text-xs">
                                            {post.frontmatter.description}
                                        </p>
                                        <time
                                            class="text-neutral-400 font-mono text-xs mt-2"
                                            datetime={post.frontmatter.pubDate}
                                        >
                                            {new Date(
                                                post.frontmatter.pubDate,
                                            ).toLocaleDateString("es-ES", {
                                                year: "numeric",
                                                month: "long",
                                                day: "numeric",
                                            })}
                                        </time>
                                    </div>
                                    <a
                                        href={`/blog/${post.frontmatter.slug || post.file.split("/").pop().replace(".md", "")}`}
                                        class="p-3 border border-neutral-800 rounded-full hover:bg-white hover:text-black transition-colors"
                                    >
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        ))
                    ) : (
                        <p>No hay posts disponibles.</p>
                    )
                }
            </div>
        </div>
    </section>
</Layout>
