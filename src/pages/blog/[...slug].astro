---
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = Object.values(
        import.meta.glob("../../content/blog/*.md", { eager: true }),
    );

    return posts.map((post: any) => {
        const slug = post.frontmatter.slug || post.file.split("/").pop().replace(".md", "");
        return {
            params: { slug },
            props: { post },
        };
    });
}

const { post } = Astro.props;
const { Content, rawContent, frontmatter } = post;
const postDate = frontmatter.pubDate || frontmatter.publishDate;
const parsedDate = postDate ? new Date(postDate) : null;
const hasValidDate = parsedDate && !Number.isNaN(parsedDate.getTime());
const formattedDate = hasValidDate
    ? parsedDate.toLocaleDateString("es-PY", {
          year: "numeric",
          month: "short",
          day: "numeric",
      })
    : "Sin fecha";

// --- Lógica de Lectura Centralizada ---
// Tip: Podrías mover esto a un archivo util.ts
const getReadingTime = (content: string) => {
    const wordsPerMinute = 200; // 150 es algo lento, 200 es el estándar humano
    const cleanText = content.replace(/<\/?[^>]+(>|$)/g, "");
    const wordCount = cleanText.split(/\s+/g).length;
    return Math.ceil(wordCount / wordsPerMinute);
};

const readingTime = getReadingTime(rawContent());
---

<Layout
    title={`${frontmatter.title} — Benjamin T.`}
    description={frontmatter.description}
    ogImg={frontmatter.heroImage}

>
    <article class="py-24 md:py-32 px-6 animate-fade-in scroll-smooth">
        <div class="max-w-3xl mx-auto">
            <header class="mb-12">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8 font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-500">
                    <time datetime={hasValidDate ? parsedDate.toISOString() : undefined} class="text-accent border-r border-neutral-800 pr-4">
                        {formattedDate}
                    </time>
                    <span class="flex items-center gap-1.5 border-r border-neutral-800 pr-4">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-70">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        {readingTime} min
                    </span>
                    <!-- Tags en el header -->
                    <div class="flex gap-2">
                        {frontmatter.tags?.map((tag: string) => (
                            <span class="text-white/40 hover:text-accent transition-colors">#{tag}</span>
                        ))}
                    </div>
                </div>

                <h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-6 leading-[0.9] text-white">
                    {frontmatter.title}
                </h1>

                <p class="text-xl text-neutral-400 leading-relaxed font-light italic border-l-2 border-accent pl-6 py-2">
                    {frontmatter.description}
                </p>
            </header>

            {frontmatter.heroImage && (
                <div class="relative group mb-16 overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900 shadow-2xl">
                    <img
                        src={frontmatter.heroImage}
                        alt={frontmatter.title}
                        class="w-full aspect-[16/9] object-cover transition-transform duration-1000 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60" />
                </div>
            )}

            <!-- Contenido con estilos Prose refinados -->
            <div class="prose prose-lg prose-invert max-w-none 
                prose-headings:font-black prose-headings:tracking-tight
                prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:border-b prose-h2:border-neutral-800 prose-h2:pb-2
                prose-p:text-neutral-300 prose-p:leading-relaxed prose-p:mb-6
                prose-strong:text-white prose-strong:font-bold
                prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-a:underline-offset-4
                prose-blockquote:border-accent prose-blockquote:bg-neutral-900/40 prose-blockquote:not-italic prose-blockquote:font-medium
                prose-pre:rounded-xl prose-pre:border prose-pre:border-neutral-800
                prose-img:rounded-2xl"
            >
                <Content />
            </div>

            <footer class="mt-24 pt-12 border-t border-neutral-800 flex flex-col gap-8">
                <!-- Share Section (Opcional pero recomendado) -->
                <div class="flex flex-col items-center justify-center py-8 bg-neutral-900/20 rounded-2xl border border-neutral-800/50">
                   <p class="font-mono text-[10px] uppercase tracking-widest text-neutral-500 mb-4">¿Te gustó el artículo? Compártelo</p>
                   <div class="flex gap-4">
                       <button onclick={`window.open('https://twitter.com/intent/tweet?text=${"Mira este artículo de Benjamin T.: " + frontmatter.title}&url=${Astro.url}')`} class="text-neutral-400 hover:text-white transition-colors">Twitter</button>
                       <button onclick={`navigator.clipboard.writeText('${"Artículo de Benjamin T.: " + frontmatter.title} ${Astro.url}')`} class="text-neutral-400 hover:text-white transition-colors">Copiar Link</button>
                   </div>
                </div>

                <a href="/blog" class="group inline-flex items-center gap-3 text-neutral-500 hover:text-white transition-colors font-mono text-xs tracking-widest uppercase">
                    <span class="p-2 rounded-full border border-neutral-800 group-hover:border-accent transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m15 18-6-6 6-6"></path>
                        </svg>
                    </span>
                    Volver a la bitácora
                </a>
            </footer>
        </div>
    </article>
</Layout>
