<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FlyxNodes | Idle Mode</title>
    <meta name="robots" content="noindex, nofollow" />

    <style>
        :root { --amber: #ffbf00; --bg: #0b0b0b; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: var(--bg);
            color: #eaeaea;
            font-family: 'Onest Variable', system-ui, sans-serif;
            overflow: hidden;
        }

        /* Glow sutil de fondo */
        body::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: var(--amber);
            filter: blur(150px);
            opacity: 0.1;
            z-index: -1;
        }

        .box {
            z-index: 10;
            text-align: center;
            border: 1px solid rgba(255, 191, 0, 0.1);
            padding: 3rem;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
        }

        .time {
            font-size: 4rem;
            font-weight: 700;
            color: var(--amber);
            text-shadow: 0 0 20px rgba(255, 191, 0, 0.3);
            margin: 0;
        }

        .status {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            opacity: 0.5;
            margin-top: 10px;
        }

        /* Banner de Adblock */
        #ab-banner {
            display: none; /* Oculto por defecto */
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #f44336;
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            z-index: 100;
            width: 90%;
            max-width: 400px;
        }
    </style>
</head>
<body>

    <div class="box">
        <div class="time" id="clock">00:00</div>
        <div class="status">FlyxNodes Engine Active</div>
    </div>

    <div id="ab-banner">
        ⚠️ <b>Adblock detectado:</b> Para apoyar el proyecto y mantener los servidores, desactivá tu bloqueador en esta pestaña. 😉
    </div>

    <script is:inline src="https://pl28351302.effectivegatecpm.com/005abbbe83bc52fbb64d769963ac6b6c/invoke.js"></script>
    <script is:inline src="https://pl28361288.effectivegatecpm.com/bd/b0/86/bdb086d6c80f71d40d9e84293af445d5.js"></script>

    <script is:inline>
        // 1. Reloj
        const tick = () => {
            const d = new Date();
            document.getElementById("clock").textContent = 
                d.getHours().toString().padStart(2, "0") + ":" + 
                d.getMinutes().toString().padStart(2, "0");
        };
        tick();
        setInterval(tick, 1000);

        // 2. Detector de Adblocker
        async function checkAdBlock() {
            let adBlockEnabled = false;
            const googleAdUrl = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js';
            try {
                const response = await fetch(new Request(googleAdUrl), { method: 'HEAD', mode: 'no-cors' });
                adBlockEnabled = false;
            } catch (e) {
                adBlockEnabled = true;
            }
            
            if(adBlockEnabled) {
                document.getElementById('ab-banner').style.display = 'block';
            }
        }
        checkAdBlock();

        // 3. Popunder controlado
        if (!sessionStorage.getItem("afk_pop")) {
            sessionStorage.setItem("afk_pop", "true");
            setTimeout(() => {
                const s = document.createElement("script");
                s.src = "https://pl28351302.effectivegatecpm.com/005abbbe83bc52fbb64d769963ac6b6c/invoke.js";
                s.async = true;
                document.head.appendChild(s);
            }, 6000);
        }
    </script>
</body>
</html>