---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="B. — InBio | Paraguay"
  description="Conoce más sobre Benja, su pasión por la tecnología y el diseño, y cómo combina ambos mundos para crear experiencias únicas."
>
<!-- Hero -->
<header class="min-h-screen flex items-center px-6 pt-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto w-full z-10">
        <div class="flex items-center space-x-3 mb-6">
            <span class="font-mono text-accent text-xs tracking-widest uppercase">Eike vai kp</span>
            <span class="h-px w-12 bg-neutral-800"></span>
            <span class="font-mono text-neutral-500 text-xs">Redirigiendo a la nueva web...</span>
        </div>
        
        <h1 class="text-6xl md:text-[9rem] font-black leading-[0.85] tracking-tighter mb-12">
            HA<br>
            UPÉI?<span class="text-accent">.</span>
        </h1>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
            <p class="max-w-md text-neutral-400 text-lg leading-relaxed">
                Llegaste a un link viejo kp, ahora te redirijo a la nueva web de Benja. Aguarda un ratito... 
            </p>
        </div>
    </div>
</header>
<script is:inline>
  setTimeout(() => {
    window.location.href = "https://byalreves.lat/";
  }, 3000); // Redirige después de 3 segundos
</script>
</Layout>