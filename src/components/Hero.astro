---
// Hero.astro - Minimalista, directo, con acento cultural sutil
---

<header class="min-h-screen flex items-center px-6 md:px-12 py-20">
    <div class="max-w-4xl">
        <!-- Subtítulo: Ubicación y rol -->
        <p class="text-sm text-neutral-400 mb-8 tracking-wide">
            Asunción, Paraguay · Tech & Design · <span id="age">17.00000000</span> años
        </p>

        <!-- Nombre principal: Simple, impactante -->
        <h1 class="text-6xl md:text-7xl font-black mb-6 leading-tight">
            Benja<span class="text-amber-400">.</span>
        </h1>

        <!-- Descripción: Dos líneas que hablan de lo que construyes -->
        <p class="text-lg md:text-xl text-neutral-300 max-w-2xl mb-12 leading-relaxed font-light">
            Construyendo infraestructura para <span class="font-semibold text-white">FlyxNodes</span>. 
            Diseñando identidades para <span class="font-semibold text-white">ByAlReves Studio</span>.
            <br />
            <span class="text-neutral-500 text-sm mt-2 block">Full-stack developer. UX/UI designer. Terrañero.</span>
        </p>

        <!-- CTA: Minimalista, solo lo necesario -->
        <div class="flex gap-6 items-center">
            <a href="#proyectos" class="text-sm text-neutral-300 border-b border-amber-400 hover:text-amber-400 transition pb-1">
                Ver proyectos →
            </a>
            <a href="#about" class="text-sm text-neutral-400 hover:text-neutral-300 transition">
                Sobre mí
            </a>
        </div>

        <!-- Divider sutil: Solo una línea -->
        <div class="mt-16 pt-8 border-t border-neutral-800"></div>

        <!-- Stats: Información clave, nada más -->
        <div class="grid grid-cols-3 gap-8 mt-8 text-xs text-neutral-500">
            <div>
                <p class="font-mono mb-1">10+</p>
                <p class="text-neutral-600">Proyectos completados</p>
            </div>
            <div>
                <p class="font-mono mb-1">3</p>
                <p class="text-neutral-600">Años en desarrollo</p>
            </div>
            <div>
                <p class="font-mono mb-1">24×7</p>
                <p class="text-neutral-600">Ops & Servidor</p>
            </div>
        </div>
    </div>
</header>

<script>
    // Edad exacta dinámica (trasladado desde Layout)
    const birthDate = new Date('2008-10-31T15:00:00Z'); 
    
    function updateAge() {
        const now = new Date();
        const diffInMs = (now as any) - (birthDate as any);
        const ageInYears = diffInMs / (1000 * 60 * 60 * 24 * 365.25);
        const ageElement = document.getElementById('age');
        if (ageElement) {
            ageElement.innerText = ageInYears.toFixed(8);
        }
    }

    setInterval(updateAge, 500);
    updateAge();
</script>
