---
// Hero.astro - Estilo ByAlReves: editorial, coordenadas y Nellyx
const lat = "-25.1683° S";
---

<header class="relative flex min-h-screen items-center overflow-hidden px-6 pt-20">
    <!-- Decoración Sutil: Coordenadas de Asunción -->
    <div class="pointer-events-none absolute right-[-5%] top-[20%] hidden select-none rotate-90 font-mono text-[15vh] font-black text-neutral-900 opacity-20 md:block">
        {lat}
        <img src="/paraguay.svg" alt="Silueta de Paraguay" class="inline-block h-16 w-16" />
    </div>

    <div class="relative z-10 mx-auto w-full max-w-7xl">
        <div class="mb-6 flex items-center space-x-3">
            <span class="font-mono text-xs uppercase tracking-widest text-accent">Tech & Creative Studio</span>
            <span class="h-px w-12 bg-neutral-800"></span>
            <span class="font-mono text-xs text-neutral-500">Asunción, PY</span>
        </div>

        <h1 class="mb-12 text-6xl font-black leading-[0.85] tracking-tighter md:text-[9rem]">
            Mbarete
            <span class="mt-4 block text-[0.4em] uppercase tracking-widest text-gray-400">
                Code & Design
            </span>
            Systems<span class="text-accent">.</span>
        </h1>

        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
            <p class="max-w-md text-lg leading-relaxed text-neutral-400">
                Construyendo el futuro de <span class="italic text-white">Nellyx</span>. Mezclando la precisión del código con la calidez de un buen tereré de mañana.
            </p>

            <div class="flex items-center space-x-6">
                <a href="#proyectos" class="group flex items-center space-x-3 text-sm font-bold uppercase tracking-tighter">
                    <span>Explorar proyectos</span>
                    <span class="rounded-full border border-neutral-800 p-4 transition-all group-hover:bg-accent group-hover:text-black">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
</header>
