---
const tags = {
    Branding: {
        name: "Branding",
        class: "bg-black text-white",
    },
    Creative: {
        name: "Creative",
        class: "bg-white text-black",
    },
    Ceo: {
        name: "CEO",
        class: "bg-amber-500 text-white",
    },
};
const projects = [
    {
        title: "FlyxNodes",
        description: "Hosting / Infrastructure / PY",
        link: "https://flyxnodes.xyz",
        image: "/projects/flyxnodes.webp",
        imageAlt: "Placeholder técnico con toque oscuro",
        tags: [tags.Branding, tags.Creative, tags.Ceo],
    },
    {
        title: "ByAlReves Studio",
        description: "Design Studio / Identity",
        link: "https://byalreves-studio.xyz",
        image: "/projects/studio.webp",
        imageAlt: "Mockup de diseño minimalista",
        tags: [tags.Branding, tags.Creative],
    },
    {
        title: "LarrVendors",
        description: "Marketplace / Web Shop / PT",
        link: "https://larrvendorss.netlify.app",
        image: "/projects/larr.webp",
        imageAlt: "Imagen representativa de tecnología y diseño",
        tags: [tags.Branding, tags.Creative],
    },
];
---

<!-- Work: Grid con placeholders paraguayos -->
<section id="proyectos" class="py-32 px-6 border-t border-neutral-900">
    <div class="max-w-7xl mx-auto">
        <div class="mb-20 flex justify-between items-baseline">
            <h2
                class="text-xs font-mono uppercase tracking-[0.5em] text-neutral-500 italic"
            >
                Selected Rembiapo
            </h2>
            <span class="text-4xl font-light">01 — 03</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
            {
                projects.map(
                    ({ title, description, link, image, imageAlt, tags }) => (
                        <div
                            class="project-card group"
                        >
                            <div class="aspect-[16/10] overflow-hidden bg-neutral-900 rounded-2xl mb-8 relative">
                                <div class="absolute inset-0 bg-neutral-900 flex items-center justify-center font-black text-[12vw] text-neutral-800 select-none group-hover:text-accent/10 transition-colors">
                                    <img
                                        src={image}
                                        alt={imageAlt}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    />
                                </div>
                                <div class="absolute bottom-6 left-6 flex space-x-2">
                                    {tags.map((tag) => 
                                        <div class={`px-3 py-1 text-[10px] font-mono uppercase rounded-full ${tag.class}`}>
                                            {tag.name}
                                        </div>
                                    )}
                                </div>
                            </div>
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-3xl font-bold tracking-tighter mb-2">
                                        {title}
                                    </h3>
                                    <p class="text-neutral-500 font-mono text-xs uppercase">
                                        {description}
                                    </p>
                                </div>
                                <a
                                    href={link}
                                    class="p-3 border border-neutral-800 rounded-full hover:bg-white hover:text-black transition-colors"
                                >
                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    ),
                )
            }
        </div>
    </div>
</section>
