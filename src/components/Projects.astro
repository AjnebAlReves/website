---
// Projects.astro - Grid limpio, sin efectos complejos
---

<section id="proyectos" class="py-20 px-6 md:px-12 bg-black">
    <div class="max-w-6xl mx-auto">
        <!-- Sección título -->
        <div class="mb-16">
            <h2 class="text-4xl md:text-5xl font-black mb-4">Proyectos</h2>
            <p class="text-neutral-400 text-sm">Trabajo seleccionado que representa mi enfoque en infraestructura y diseño.</p>
        </div>

        <!-- Grid: 2 columnas en mobile, 2+ en desktop -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Project 1: FlyxNodes -->
            <a href="https://flyxnodes.xyz" target="_blank" rel="noopener noreferrer" class="group">
                <div class="bg-neutral-900 border border-neutral-800 hover:border-amber-400 transition p-8 h-full flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold mb-2 group-hover:text-amber-400 transition">
                            FlyxNodes
                        </h3>
                        <p class="text-neutral-400 text-sm mb-4">
                            Infraestructura cloud descentralizada. Arquitectura de servidor, optimización de performance, planes escalables.
                        </p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Node.js</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Docker</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">PostgreSQL</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Infraestructura</span>
                    </div>
                </div>
            </a>

            <!-- Project 2: ByAlReves Studio -->
            <a href="https://byalreves.studio" target="_blank" rel="noopener noreferrer" class="group">
                <div class="bg-neutral-900 border border-neutral-800 hover:border-amber-400 transition p-8 h-full flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold mb-2 group-hover:text-amber-400 transition">
                            ByAlReves Studio
                        </h3>
                        <p class="text-neutral-400 text-sm mb-4">
                            Agencia de diseño y branding. Identidades visuales, web design, consultoría creativa para startups.
                        </p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Figma</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">React</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Brand</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Design</span>
                    </div>
                </div>
            </a>

            <!-- Project 3: LarrVendors -->
            <a href="#" class="group">
                <div class="bg-neutral-900 border border-neutral-800 hover:border-amber-400 transition p-8 h-full flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold mb-2 group-hover:text-amber-400 transition">
                            LarrVendors
                        </h3>
                        <p class="text-neutral-400 text-sm mb-4">
                            Plataforma de marketplace descentralizado. Sistema de pagos, gestión de vendors, frontend escalable.
                        </p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Astro</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Blockchain</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Web3</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Pagos</span>
                    </div>
                </div>
            </a>

            <!-- Project 4: Blog/Content -->
            <a href="/blog" class="group">
                <div class="bg-neutral-900 border border-neutral-800 hover:border-amber-400 transition p-8 h-full flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold mb-2 group-hover:text-amber-400 transition">
                            Blog & Artículos
                        </h3>
                        <p class="text-neutral-400 text-sm mb-4">
                            Escribo sobre desarrollo, diseño, infraestructura y reflexiones sobre tecnología en Latinoamérica.
                        </p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Tech</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Opinión</span>
                        <span class="text-xs bg-neutral-800 text-neutral-300 px-2 py-1">Educación</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<style>
    /* Sin efectos complejos, solo transiciones suaves */
    a {
        text-decoration: none;
    }

    .group:hover h3 {
        color: #fbbf24;
    }

    .group:hover .bg-neutral-900 {
        background-color: rgba(17, 24, 39, 0.6);
    }
</style>
