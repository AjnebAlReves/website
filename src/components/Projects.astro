---
const tags = {
    Infra: { name: "Infra", class: "bg-black text-white" },
    Branding: { name: "Branding", class: "bg-white text-black" },
    Creative: { name: "Creative", class: "bg-amber-500 text-white" },
    Product: { name: "Product", class: "bg-white text-black" },
    Web: { name: "Web", class: "bg-black text-white" },
    Minecraft: { name: "Minecraft", class: "bg-emerald-900/80 text-emerald-200" },
    App: { name: "App", class: "bg-black text-white" },
};

const projects = [
    {
        title: "Nellyx Infra",
        subtitle: "Infraestructura / Cloud / PY",
        link: "https://nellyx.xyz",
        image: "/projects/nellyx.webp",
        imageAlt: "Nellyx proyecto de infraestructura",
        tags: [tags.Infra, tags.Product, tags.Web],
    },
    {
        title: "Nellyx Brand",
        subtitle: "Branding / Identidad / PY",
        link: "https://nellyx.xyz",
        image: "/projects/nellyx.webp",
        imageAlt: "Nellyx branding",
        tags: [tags.Branding, tags.Creative, tags.Product],
    },
    {
        title: "LarrVendors",
        subtitle: "Marketplace / Web Shop / PT",
        link: "https://larrvendorss.netlify.app",
        image: "/projects/larr.webp",
        imageAlt: "LarrVendors marketplace",
        tags: [tags.Web, tags.Product, tags.Creative],
    },
    {
        title: "StaffControl",
        subtitle: "Minecraft Plugin / Open Source",
        link: "https://github.com/AjnebAlReves/StaffControl/",
        image: "/projects/wip.svg",
        imageAlt: "StaffControl plugin placeholder",
        tags: [tags.Minecraft, tags.Product],
    },
    {
        title: "Churchtils",
        subtitle: "App / Iglesia / PY",
        link: "https://github.com/AjnebAlReves/churchtils",
        image: "/projects/wip.svg",
        imageAlt: "Churchtils app placeholder",
        tags: [tags.App, tags.Product, tags.Creative],
    },
];

const count = String(projects.length).padStart(2, "0");
---

<section id="proyectos" class="border-t border-neutral-900 px-6 py-32">
    <div class="mx-auto max-w-7xl">
        <div class="mb-20 flex items-baseline justify-between">
            <h2 class="font-mono text-xs uppercase italic tracking-[0.5em] text-neutral-500">
                Selected Rembiapo
            </h2>
            <span class="text-4xl font-light">01 — {count}</span>
        </div>

        <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
            {
                projects.map(({ title, subtitle, link, image, imageAlt, tags }) => (
                    <article class="project-card group">
                        <div class="relative mb-8 aspect-[16/10] overflow-hidden rounded-2xl bg-neutral-900">
                            <img
                                src={image}
                                alt={imageAlt}
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                            <div class="absolute bottom-6 left-6 flex space-x-2">
                                {tags.map((tag) => (
                                    <span class={`rounded-full px-3 py-1 font-mono text-[10px] uppercase ${tag.class}`}>
                                        {tag.name}
                                    </span>
                                ))}
                            </div>
                        </div>

                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="mb-2 text-3xl font-bold tracking-tighter">{title}</h3>
                                <p class="font-mono text-xs uppercase text-neutral-500">{subtitle}</p>
                            </div>
                            <a
                                href={link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="rounded-full border border-neutral-800 p-3 transition-colors hover:bg-white hover:text-black"
                                aria-label={`Ver ${title}`}
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
