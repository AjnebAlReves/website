---
// No imports needed
---

<!-- Work: Grid con placeholders paraguayos -->
<section id="proyectos" class="py-32 px-6 border-t border-neutral-900">
    <div class="max-w-7xl mx-auto">
        <div class="mb-20 flex justify-between items-baseline">
            <h2 class="text-xs font-mono uppercase tracking-[0.5em] text-neutral-500 italic">Selected Rembiapo</h2>
            <span class="text-4xl font-light">01 — 03</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
            <!-- Project 1: FlyxNodes con placeholder de imagen -->
            <div class="project-card group" data-aos="fade-up">
                <div class="aspect-[16/10] overflow-hidden bg-neutral-900 rounded-2xl mb-8 relative group">
                    <!-- ESPACIO PARA FOTO: Idealmente algo técnico con un toque oscuro -->
                    <div class="absolute inset-0 bg-neutral-800 nanduti-pattern group-hover:scale-105 transition-transform duration-700"></div>
                    <div class="absolute inset-0 flex items-center justify-center opacity-10 group-hover:opacity-30 transition-opacity">
                        <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"/></svg>
                    </div>
                    <div class="absolute top-6 right-6">
                        <div class="w-2 h-2 rounded-full bg-accent animate-pulse"></div>
                    </div>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="text-3xl font-bold tracking-tighter mb-2">FlyxNodes</h3>
                        <p class="text-neutral-500 font-mono text-xs uppercase">Hosting / Infrastructure / PY</p>
                    </div>
                    <a href="https://flyxnodes.xyz" class="p-3 border border-neutral-800 rounded-full hover:bg-white hover:text-black transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                </div>
            </div>

            <!-- Project 2: ByAlReves con placeholder estético -->
            <div class="project-card group" data-aos="fade-up" data-aos-delay="100">
                <div class="aspect-[16/10] overflow-hidden bg-neutral-900 rounded-2xl mb-8 relative">
                    <!-- ESPACIO PARA FOTO: Aquí podrías poner un mockup de diseño minimalista -->
                    <div class="absolute inset-0 bg-neutral-900 flex items-center justify-center font-black text-[12vw] text-neutral-800 select-none group-hover:text-accent/10 transition-colors">
                        AR
                    </div>
                    <div class="absolute bottom-6 left-6 flex space-x-2">
                        <span class="bg-white/10 backdrop-blur-md px-3 py-1 rounded-full text-[9px] font-mono uppercase tracking-widest">Branding</span>
                        <span class="bg-white/10 backdrop-blur-md px-3 py-1 rounded-full text-[9px] font-mono uppercase tracking-widest">Creative</span>
                    </div>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="text-3xl font-bold tracking-tighter mb-2">ByAlReves Studio</h3>
                        <p class="text-neutral-500 font-mono text-xs uppercase">Design Studio / Identity</p>
                    </div>
                    <a href="https://byalreves.lat" class="p-3 border border-neutral-800 rounded-full hover:bg-white hover:text-black transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
