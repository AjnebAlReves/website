---
// No props needed
---

<!-- Footer: Simple & Bold -->
<footer id="contacto" class="bg-white text-black py-32 px-6">
    <div class="max-w-7xl mx-auto border-t border-neutral-100 pt-20">
        <div class="text-center">
            <p class="font-mono text-[10px] tracking-[0.5em] uppercase mb-12">Contacto / Ñañe'e pues / Let's talk</p>
            <form action="https://tu-endpoint-especifico.com/contact" method="POST" class="max-w-md mx-auto">
                <div class="mb-4">
                    <input type="text" name="name" placeholder="Tu nombre" required class="w-full px-4 py-2 border border-neutral-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent">
                </div>
                <div class="mb-4">
                    <input type="email" name="email" placeholder="Tu email" required class="w-full px-4 py-2 border border-neutral-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent">
                </div>
                <div class="mb-6">
                    <textarea name="message" placeholder="Tu mensaje" rows="4" required class="w-full px-4 py-2 border border-neutral-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent resize-none"></textarea>
                </div>
                <button type="submit" class="w-full bg-black text-white py-2 px-4 rounded-md hover:bg-accent transition-colors duration-300 font-mono uppercase text-sm tracking-wider">
                    Enviar
                </button>
            </form>
        </div>

        <div class="mt-40 flex flex-col md:flex-row justify-between items-center gap-8 text-[10px] font-mono uppercase tracking-[0.2em] text-neutral-400">
            <div class="flex items-center gap-4">
                <span>ASU</span>
                <span class="w-8 h-px bg-neutral-200"></span>
                <span>PY</span>
            </div>
            <div class="flex gap-12">
                <a href="https://github.com/ajnebalreves" class="hover:text-black transition-colors">GitHub</a>
                <a href="https://instagram.com/ajnebalreves" class="hover:text-black transition-colors">Instagram</a>
                <a href="https://discord.com/channels/@me/1362955656596029594" class="hover:text-black transition-colors">Discord</a>
            </div>
            <p>© 2025 Benja — Crafted in the heart of South America</p>
        </div>
    </div>
</footer>
