---
// Footer.astro - Contacto directo + referencias mínimas
---

<footer class="bg-black border-t border-neutral-900 py-12 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
        <!-- Grid: Contact + Links + Cultural reference -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
            <!-- Contacto directo -->
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-neutral-300">Contacto</h3>
                <div class="space-y-2">
                    <a href="mailto:hola@byalreves.dev" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        hola@byalreves.dev
                    </a>
                    <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        Twitter / X
                    </a>
                    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        GitHub
                    </a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        LinkedIn
                    </a>
                </div>
            </div>

            <!-- Proyectos principales -->
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-neutral-300">Proyectos</h3>
                <div class="space-y-2">
                    <a href="https://flyxnodes.xyz" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        FlyxNodes
                    </a>
                    <a href="https://byalreves.studio" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        ByAlReves Studio
                    </a>
                    <a href="/blog" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        Blog
                    </a>
                    <a href="/inbio" class="text-sm text-neutral-400 hover:text-amber-400 transition block">
                        Links Bio
                    </a>
                </div>
            </div>

            <!-- Info + Ubicación cultural sutil -->
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-neutral-300">Info</h3>
                <div class="space-y-3 text-sm text-neutral-400">
                    <p>
                        Asunción, Paraguay
                        <br />
                        <span class="font-mono text-xs">-25.2637° S, -57.5759° W</span>
                    </p>
                    <p class="text-xs italic text-neutral-500">
                        "Terrañero. Tech builder. Toma tereré."
                    </p>
                </div>
            </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-neutral-900 py-8">
            <!-- Bottom info -->
            <div class="flex flex-col md:flex-row justify-between items-center gap-6 text-xs text-neutral-500">
                <p>© 2024 Benjamín Rodríguez. All rights reserved.</p>
                <div class="flex gap-6">
                    <a href="#" class="hover:text-neutral-300 transition">Privacy</a>
                    <a href="#" class="hover:text-neutral-300 transition">Terms</a>
                    <a href="#" class="hover:text-neutral-300 transition">Sitemap</a>
                </div>
                <p class="text-neutral-600">v2.0 · Minimalismo intencional</p>
            </div>
        </div>
    </div>
</footer>
