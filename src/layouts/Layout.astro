---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    ogImg?: string;
}

const { description, title, ogImg = "/projects/porfolio.webp" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImg}>
    <title>{title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #000000;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Links globales: minimalista */
        a {
            transition: color 0.2s ease, border-color 0.2s ease;
            text-decoration: none;
        }

        /* Scroll smooth */
        html {
            scroll-behavior: smooth;
        }

        /* Remover outline por defecto en navegación */
        nav a:focus {
            outline: 2px solid #fbbf24;
            outline-offset: 2px;
        }
    </style>
    <ClientRouter />
</head>
<body class="flex flex-col min-h-screen">

    <!-- Navegación: Minimalista, top-right -->
    <nav class="px-6 md:px-12 py-6 flex justify-between items-center border-b border-neutral-900">
        <a href="/" class="font-black text-lg hover:text-amber-400 transition">
            Benja<span class="text-amber-400">.</span>
        </a>
        <div class="flex gap-8">
            <a href="#proyectos" class="text-xs text-neutral-400 hover:text-neutral-200 transition">Proyectos</a>
            <a href="#about" class="text-xs text-neutral-400 hover:text-neutral-200 transition">Sobre mí</a>
            <a href="/blog" class="text-xs text-neutral-400 hover:text-neutral-200 transition">Blog</a>
        </div>
    </nav>

    <!-- Content: Flujo directo, sin centrado forzado -->
    <main class="flex-grow">
        <slot />
    </main>
</body>
</html>