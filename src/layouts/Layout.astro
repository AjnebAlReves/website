---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    ogImg?: string;
}

const { description, title, ogImg = "/projects/porfolio.webp" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImg}>
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #000000;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-image: radial-gradient(circle at 15% -10%, rgba(251, 191, 36, 0.07), transparent 32%);
        }

        /* Links globales: minimalista */
        a {
            transition: color 0.2s ease, border-color 0.2s ease;
            text-decoration: none;
        }

        /* Scroll smooth */
        html {
            scroll-behavior: smooth;
        }

        /* Remover outline por defecto en navegación */
        nav a:focus {
            outline: 2px solid #fbbf24;
            outline-offset: 2px;
        }

        /* Efecto de grano/noise para textura */
        .noise {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url("https://grainy-gradients.vercel.app/noise.svg");
            opacity: 0.018;
            mix-blend-mode: soft-light;
            pointer-events: none;
            z-index: 1;
        }

        /* Patrón de Ñandutí Digital */
        .nanduti-pattern {
            background-image: radial-gradient(circle at center, #222 1px, transparent 1px);
            background-size: 20px 20px;
            opacity: 0.3;
        }
    </style>
    <ClientRouter />
</head>
<body class="flex flex-col min-h-screen overflow-x-hidden">
    <div class="noise"></div>
    <div
        id="bt31-easter-egg"
        class="pointer-events-none fixed bottom-6 right-6 z-50 hidden rounded-full border border-amber-500/50 bg-black/85 px-4 py-2 font-mono text-xs uppercase tracking-[0.2em] text-amber-300"
    >
        BT31 unlocked
    </div>

    <!-- Navegación: Minimalista, top-right -->
    <nav class="relative z-10 px-6 md:px-12 py-6 flex justify-between items-center border-b border-neutral-900">
        <a href="/" class="font-black text-lg hover:text-amber-400 transition">
            Benja<span class="text-amber-400">.</span>
        </a>
        <div class="flex gap-8">
            <a href="#proyectos" class="text-xs text-neutral-400 hover:text-neutral-200 transition">Proyectos</a>
            <a href="#about" class="text-xs text-neutral-400 hover:text-neutral-200 transition">Sobre mí</a>
            <a href="/blog" class="text-xs text-neutral-400 hover:text-neutral-200 transition">Blog</a>
        </div>
    </nav>

    <!-- Content: Flujo directo, sin centrado forzado -->
    <main class="relative z-10 flex-grow">
        <slot />
    </main>
    <script>
        const egg = document.getElementById("bt31-easter-egg");
        let buffer = "";
        let timeoutId: ReturnType<typeof setTimeout> | null = null;

        window.addEventListener("keydown", (event) => {
            if (event.ctrlKey || event.metaKey || event.altKey) return;
            const key = event.key.toLowerCase();
            if (!/^[a-z0-9]$/.test(key)) return;

            buffer = (buffer + key).slice(-4);
            if (buffer !== "bt31" || !egg) return;

            egg.classList.remove("hidden");
            if (timeoutId) clearTimeout(timeoutId);
            timeoutId = setTimeout(() => {
                egg.classList.add("hidden");
            }, 2200);
            buffer = "";
        });
    </script>
</body>
</html>
